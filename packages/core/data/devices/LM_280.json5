{
  key: 'LM_280',
  name: 'LabelManager 280',
  family: 'labelmanager',
  transports: {
    usb: { vid: '0x0922', pid: '0x1006' },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'd1-tape',
      dpi: 180,
      headDots: 64,
      mediaCompatibility: ['d1'],
      // D1 cassette dead-zone defaults — see LM_PNP.json5 for
      // the geometry rationale. Same values on every D1 chassis
      // today; re-validate per-device as measurements arrive.
      printableArea: { leading: 0, trailing: 0, left: 0, right: 0 },
      forcedTrailingFeedMm: 16,
    },
  ],
  hardwareQuirks: 'Enumerates as USB Mass Storage Class on first connect under PID `0x1005`; needs `usb_modeswitch` on Linux to switch to the printer interface (PID `0x1006`). PID single-sourced from labelle — needs hardware verification.',
  support: {
    status: 'untested',
  },
}
