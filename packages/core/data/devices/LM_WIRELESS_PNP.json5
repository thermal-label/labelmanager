{
  key: 'LM_WIRELESS_PNP',
  name: 'LabelManager Wireless PnP',
  family: 'labelmanager',
  transports: {
    usb: { vid: '0x0922', pid: '0x1008' },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'd1-tape',
      dpi: 180,
      headDots: 64,
      mediaCompatibility: ['d1', 'd1-19', 'd1-wide'],
      // D1 cassette dead-zone defaults — see LM_PNP.json5 for
      // the geometry rationale. Same values on every D1 chassis
      // today; re-validate per-device as measurements arrive.
      printableArea: { leading: 0, trailing: 0, left: 0, right: 0 },
      forcedTrailingFeedMm: 16,
    },
  ],
  hardwareQuirks: 'Enumerates as USB Mass Storage Class on first connect under PID `0x1007`; needs `usb_modeswitch` on Linux to switch to the printer interface (PID `0x1008`). Wireless connectivity is not exposed by this driver — only the USB printer interface. Chassis accepts D1 cartridges in 6/9/12/19/24mm widths per the official Wireless PnP technical datasheet (download.dymo.com/dymo/user-guides/LabelManager/LMWirelessPnP/LabelManager_Wireless_PnP_Technical_Datasheet.pdf); the 24mm path is gated on the wide-tier rasterizer work — see plans/backlog/wide-tier-media-compatibility.md.',
  support: {
    status: 'untested',
  },
}
