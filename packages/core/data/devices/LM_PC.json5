{
  key: 'LM_PC',
  name: 'LabelManager PC',
  family: 'labelmanager',
  transports: {
    usb: { vid: '0x0922', pid: '0x0011' },
  },
  engines: [
    {
      role: 'primary',
      protocol: 'd1-tape',
      dpi: 180,
      headDots: 64,
      mediaCompatibility: ['d1'],
      // Hoisted from the encoder's pre-0.6.0 `FEED_MARGIN_PX = 57`
      // constant — see LM_PNP.json5 for the rationale. Same values
      // on every D1 chassis today; re-validate per-device as
      // measurements arrive.
      printableArea: { leading: 8, trailing: 0, left: 0, right: 0 },
      forcedTrailingFeedMm: 8,
    },
  ],
  hardwareQuirks: 'No mass-storage decoy — presents a single PID directly. PID corrected from `0x1002` (which was a copy-paste from the PnP entry in the previous registry) to `0x0011` based on community sources (labelle constants + an `lsusb` capture in dymoprint#93).',
  support: {
    status: 'untested',
  },
}
